# Auto detect text files and perform LF normalization
* text=auto

# Final experiment checkpoints are research artifacts and are too large for normal Git blobs.
TrainingRuns/*/checkpoints/*.pth filter=lfs diff=lfs merge=lfs -text
TrainingRuns/*/checkpoints/*.pt filter=lfs diff=lfs merge=lfs -text
TrainingRuns/*/checkpoints/*.ckpt filter=lfs diff=lfs merge=lfs -text
